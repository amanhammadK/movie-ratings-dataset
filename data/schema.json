{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Movie Ratings Dataset",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "genre": {
        "type": "string"
      },
      "rating": {
        "type": "number"
      },
      "votes": {
        "type": "integer"
      }
    }
  }
}
